// Участник 2: HTTP API и координация бизнес-сценариев.
api = container "API" "Предоставляет данные доставок и координирует расчёт прогнозов." "Go / net/http" {
    deliveryEndpoint = component "API доставок" "Принимает запросы списка доставок и их статусов." "Go / net/http"
    forecastEndpoint = component "API прогнозов" "Принимает запросы расчёта прогноза задержки." "Go / net/http"
    accessControl = component "Контроль доступа" "Проверяет право пользователя читать доставку и получать прогноз." "Go"
    forecastCoordinator = component "Сервис прогнозов" "Загружает данные, запрашивает прогноз и сохраняет результат." "Go"
}
