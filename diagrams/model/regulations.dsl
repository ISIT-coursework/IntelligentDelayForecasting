// Аналитик: регламенты получателей и аналитика задержек.
regulationService = container "Сервис регламентов и аналитики" "Разбирает и проверяет регламенты, управляет их версиями, передаёт фрагменты в индекс и строит отчёты по задержкам" "Python, FastAPI" {
    group "Слой интерфейса" {
        regulationController = component "Контроллер регламентов" "Принимает от основного API файлы регламентов и команды публикации" "FastAPI Router, Pydantic"
        reportController = component "Контроллер отчётов" "Принимает запросы отчётов по задержкам и точности прогнозов" "FastAPI Router, Pydantic"
    }

    group "Прикладной слой" {
        regulationIngestion = component "Загрузка и разбор" "Выбирает способ разбора по формату файла, извлекает текст и условия приёмки" "Python"
        versionManager = component "Менеджер версий" "Ведёт жизненный цикл версии: черновик, проверена, опубликована, в архиве" "Python"
        conditionValidator = component "Проверка условий" "Проверяет полноту и непротиворечивость извлечённых условий" "Python"
        indexPublisher = component "Публикация в индекс" "Делит опубликованную версию на фрагменты, считает эмбеддинги и записывает их в индекс" "Python, Sentence Transformers"
        delayAnalytics = component "Аналитика задержек" "Сравнивает прогнозы с фактическими результатами и считает показатели качества" "Python, pandas"
    }

    group "Инфраструктурный слой" {
        regulationRepository = component "Репозиторий регламентов" "Читает и сохраняет версии и условия регламентов" "Python, SQLAlchemy"
        documentStore = component "Клиент хранилища документов" "Сохраняет и читает оригиналы регламентов" "Python, boto3"
        analyticsReader = component "Клиент аналитического хранилища" "Читает историю прогнозов и фактические результаты" "Python, clickhouse-connect"
    }
}
