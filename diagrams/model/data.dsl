// Участник 4: обработка данных внутри API и отдельное хранилище.
// !element дополняет существующий контейнер, не создавая новый сервис.
!element api {
    dataImporter = component "Импорт доставок" "Принимает статусы и плановые сроки из транспортной системы." "Go"
    dataValidator = component "Проверка данных" "Проверяет идентификаторы, даты и обязательные параметры доставки." "Go"
    dataNormalizer = component "Нормализация данных" "Приводит статусы и маршруты к общей модели данных." "Go"
    deliveryRepository = component "Репозиторий доставок" "Читает и сохраняет доставки, историю и прогнозы." "Go / database/sql"
}

database = container "База данных" "Хранит доставки, историю статусов и результаты прогнозов." "PostgreSQL" {
    tags "Database"
}
