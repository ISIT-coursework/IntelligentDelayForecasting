styles {
    element "Element" {
        color #ffffff
    }
    element "Person" {
        shape Person
        background #08427b
    }
    element "Software System" {
        background #1168bd
    }
    element "Container" {
        background #438dd5
    }
    element "Component" {
        background #6b9ed0
