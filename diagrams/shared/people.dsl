dispatcher = person "Диспетчер" "Контролирует доставки и реагирует на прогнозируемые задержки."
analyst = person "Логистический аналитик" "Анализирует причины задержек и точность прогнозов."
administrator = person "Администратор" "Настраивает доступ пользователей и параметры интеграций."
manager = person "Руководитель логистики" "Просматривает показатели перевозок и отчёты о рисках"
customer = person "Представитель заказчика" "Ведёт регламенты приёмки и отслеживает уведомления в личном кабинете"
