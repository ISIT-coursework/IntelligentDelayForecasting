// Пользователи и контейнеры.
dispatcher -> web "Работает со списком рисков, карточкой рейса и чатом по регламентам" "HTTPS"
manager -> web "Просматривает сводки и отчёты по перевозкам" "HTTPS"
customer -> web "Загружает регламенты и читает уведомления" "HTTPS"
dispatcher -> mobile "Проверяет прогноз в пути" "HTTPS"
analyst -> web "Просматривает аналитику задержек" "HTTPS"
administrator -> web "Настраивает доступ и интеграции" "HTTPS"
web -> api "Загружает рейсы и отчёты, передаёт вопросы и файлы регламентов" "HTTPS / JSON, multipart/form-data"
mobile -> api "Запрашивает статусы и риск задержки" "JSON/HTTPS"
api -> database "Читает и сохраняет доставки и прогнозы" "SQL/TCP"
transport -> api "Передаёт статусы и плановые сроки" "JSON/HTTPS"
api -> maps "Запрашивает параметры маршрута" "JSON/HTTPS"

// Веб-интерфейс и API.
dispatcher -> appShell "Открывает рабочее место диспетчера" "HTTPS"
manager -> appShell "Открывает панель отчётов" "HTTPS"
customer -> appShell "Открывает личный кабинет" "HTTPS"
appShell -> sessionState "Получает профиль и роль; инициирует выход" "TypeScript Call"
appShell -> tripsScreen "Открывает список и карточку рейса" "React composition"
appShell -> customerScreen "Открывает документы и уведомления" "React composition"
appShell -> reportsScreen "Открывает отчёты" "React composition"
tripsScreen -> ragChat "Открывает чат с идентификатором выбранного рейса" "React props"
tripsScreen -> queryStore "Запрашивает рейсы и детали; сохраняет действия" "TypeScript Call"
ragChat -> queryStore "Загружает историю; отправляет вопрос; получает ответ и источники" "TypeScript Call"
customerScreen -> queryStore "Загружает регламенты; получает статусы и уведомления" "TypeScript Call"
reportsScreen -> queryStore "Запрашивает отчёты по периоду и фильтрам" "TypeScript Call"
sessionState -> apiClient "Запрашивает текущий сеанс и завершает его" "TypeScript Call"
queryStore -> apiClient "Вызывает типизированные методы работы с данными и файлами" "TypeScript Call"
apiClient -> api "Запрашивает данные и источники; отправляет вопросы, действия и файлы" "HTTPS / JSON, multipart"
mobile -> deliveryEndpoint "Получает статусы доставок" "JSON/HTTPS"
mobile -> forecastEndpoint "Получает прогноз доставки" "JSON/HTTPS"

// Участник 2: проверка доступа и бизнес-сценарий.
deliveryEndpoint -> accessControl "Проверяет доступ к списку доставок" "Go function call"
forecastEndpoint -> accessControl "Проверяет доступ к прогнозу" "Go function call"
deliveryEndpoint -> deliveryRepository "Читает доставки" "Go function call"
forecastEndpoint -> forecastCoordinator "Запрашивает сохранённую оценку риска рейса" "Go function call"
forecastCoordinator -> deliveryRepository "Читает историю и сохраняет результат" "Go function call"

// Участник 4: получение, проверка и сохранение данных.
transport -> dataImporter "Передаёт обновления статусов доставок" "JSON/HTTPS"
dataImporter -> dataValidator "Проверяет входящие данные" "Go function call"
dataValidator -> dataNormalizer "Передаёт проверенные данные" "Go function call"
dataNormalizer -> maps "Получает параметры маршрута" "JSON/HTTPS"
dataNormalizer -> deliveryRepository "Сохраняет нормализованную доставку" "Go function call"
deliveryRepository -> database "Читает и записывает данные" "SQL/TCP"

// Предиктор и обучение
api -> kafka "Публикует события рейсов и получает результаты прогнозирования" "Kafka protocol / TCP"
forecastCoordinator -> kafka "Публикует снимки рейсов и получает оценки риска" "Kafka protocol / TCP"
predictor -> kafka "Читает снимки рейсов и публикует риск задержки и версию модели" "Kafka protocol / TCP"
predictor -> objects "Загружает версию модели и схему признаков" "S3 API / HTTPS"
training -> analytics "Читает исторические снимки и результаты рейсов" "ClickHouse native protocol / TCP"
training -> objects "Сохраняет проверенные модели и метрики" "S3 API / HTTPS"

// RAG и поиск регламентов
api -> rag "Передаёт вопрос, контекст рейса и разрешённые версии регламентов" "HTTP / JSON"
rag -> vectors "Ищет доступные фрагменты регламентов" "HTTP / JSON"
rag -> llmProvider "Запрашивает генерацию ответа по найденным фрагментам" "HTTPS / JSON"

api -> ragApi "Передаёт вопрос и проверенные ограничения поиска" "HTTP / JSON"
ragApi -> ragOrchestrator "Передаёт проверенный запрос" "Python function call"
ragOrchestrator -> queryEncoder "Получает эмбеддинг вопроса" "Python function call"
ragOrchestrator -> regulationSearch "Передаёт вектор вопроса и ограничения поиска" "Python function call"
ragOrchestrator -> promptBuilder "Передаёт вопрос, факты рейса и найденные фрагменты" "Python function call"
ragOrchestrator -> llmClient "Запрашивает генерацию по подготовленному промпту" "Python function call"
ragOrchestrator -> answerBuilder "Передаёт результат генерации и допустимые источники" "Python function call"
regulationSearch -> vectors "Ищет фрагменты по вектору и фильтрам" "HTTP / JSON"
llmClient -> llmProvider "Запрашивает генерацию ответа" "HTTPS / JSON"

// Аналитик: регламенты и аналитика задержек.
api -> regulationService "Передаёт файлы регламентов, команды публикации и запросы отчётов" "HTTP / JSON, multipart/form-data"
regulationService -> database "Читает и сохраняет версии и условия регламентов" "SQL/TCP"
regulationService -> objects "Сохраняет и читает оригиналы регламентов" "S3 API / HTTPS"
regulationService -> vectors "Записывает фрагменты опубликованных версий" "HTTP / JSON"
regulationService -> analytics "Читает историю прогнозов и фактические результаты" "ClickHouse native protocol / TCP"

api -> regulationController "Передаёт файлы регламентов и команды публикации" "HTTP / JSON, multipart/form-data"
api -> reportController "Запрашивает отчёты по периоду и фильтрам" "HTTP / JSON"
regulationController -> regulationIngestion "Передаёт файл на разбор" "Python function call"
regulationController -> versionManager "Запускает публикацию и архивацию версии" "Python function call"
regulationIngestion -> documentStore "Сохраняет оригинал файла" "Python function call"
regulationIngestion -> versionManager "Создаёт черновик версии с условиями" "Python function call"
versionManager -> conditionValidator "Проверяет условия перед публикацией" "Python function call"
versionManager -> indexPublisher "Передаёт опубликованную версию на индексацию" "Python function call"
versionManager -> regulationRepository "Сохраняет версии и статусы" "Python function call"
reportController -> delayAnalytics "Запрашивает расчёт отчёта" "Python function call"
delayAnalytics -> analyticsReader "Получает прогнозы и фактические результаты" "Python function call"
regulationRepository -> database "Читает и записывает версии и условия" "SQL/TCP"
documentStore -> objects "Сохраняет и читает файлы" "S3 API / HTTPS"
indexPublisher -> vectors "Записывает фрагменты, эмбеддинги и метаданные доступа" "HTTP / JSON"
analyticsReader -> analytics "Выполняет аналитические запросы" "ClickHouse native protocol / TCP"
